# Copy to .env and adjust. All paths default to ./_workdir/<subdir> if unset.

# Root under which trained adapter pools are written/read.
# Each pool is a directory: $POOL_DIR/<pool_name>/{metadata.parquet, adapters/<key>/adapter_model.safetensors}
POOL_DIR=./_workdir/pools

# Root under which experiment outputs (tables, figures, npz) are written.
RESULTS_DIR=./_workdir/results

# Scratch cache for prepared datasets (HF save_to_disk) and misc intermediates.
CACHE_DIR=./_workdir/cache

# Base model. The paper uses meta-llama/Llama-3.2-1B (gated on the HF Hub).
BASE_MODEL=meta-llama/Llama-3.2-1B

# Optional: HuggingFace token for gated models / private datasets.
# HF_TOKEN=hf_xxx

# Optional experiment logging (requires the `logging` extra). Leave disabled to no-op.
WANDB_MODE=disabled
# WANDB_PROJECT=lora-geometry
# WANDB_ENTITY=
